# 🌸 Nakama Environment Variables — Example Template
# ⚠️ THIS FILE IS SAFE TO COMMIT — it contains NO real secrets
# Copy this to .env and fill in real values

# === General ===
OFFLINE_MODE=0
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT=20
RATE_LIMIT=60/minute
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=50
UVICORN_WORKERS=2

# === Database ===
# PostgreSQL (production) — see docs/SECRET-ROTATION.md
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/nakama
POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=CHANGE_ME_USE_32_CHARS_RANDOM

# === Redis ===
REDIS_URL=redis://redis:6379/0
RESPONSE_CACHE_REDIS_URL=redis://redis:6379/1

# === Auth & Security ===
# Generate JWT_SECRET with: openssl rand -base64 48 | head -c 64
JWT_SECRET=CHANGE_ME_USE_64_CHARS_RANDOM
# Generate API_KEY with: openssl rand -base64 48 | head -c 64
API_KEY=CHANGE_ME_USE_64_CHARS_RANDOM
# Comma-separated list of additional API keys for multi-tenant
API_KEYS=
DEFAULT_DAILY_QUOTA=1000

# === CORS ===
# Production: https://mynakama.web.id,https://mynakama.web.id
ALLOW_ORIGINS=*
PUBLIC_BASE_URL=https://api.mynakama.web.id

# === Source URL overrides ===
KIRYUU_BASE_URL=https://v7.kiryuu.to
KOMIKCAST_API_BASE=https://be.komikcast.cc
KOMIKCAST_BASE_URL=https://v3.komikcast.fit
KOMIKCAST_TOKEN=obtain_via_python_scripts/komikcast_login.py
SAKURANOVEL_BASE_URL=https://sakuranovel.id

# === Anti-detect (Camoufox / FlareSolverr) ===
FLARESOLVERR_URL=http://flaresolverr:8191/v1

# === SMTP (Resend / Brevo) ===
# Get SMTP_PASS from https://resend.com/api-keys
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_CHANGE_ME_FROM_RESEND_DASHBOARD
SMTP_FROM=noreply@yourdomain.com
SMTP_TLS=1

# === Telegram bot (notifications) ===
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=CHANGE_ME_FROM_BOTFATHER
TELEGRAM_CHAT_ID=CHANGE_ME_YOUR_CHAT_ID

# === Internal ===
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=https://mynakama.web.id
