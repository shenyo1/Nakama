# NakamaApi / Nakama environment configuration
# Copy to .env (dev) or .env.production (VPS). The app reads os.environ directly.
#
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# ── Core ────────────────────────────────────────────────────────────────────

# When true, sources serve local fixtures/ instead of the network.
OFFLINE_MODE=0

# Cache lifetime for upstream responses (seconds)
CACHE_TTL_SECONDS=900

# Per-request timeout to upstream sites (seconds)
REQUEST_TIMEOUT=20

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=50

# Rate limit per client IP. Format: "<count>/<period>". Default: 60 req/min.
RATE_LIMIT=60/minute

# ── Database (Postgres) ─────────────────────────────────────────────────────
# Required for production. SQLite fallback for dev/CI.
# DATABASE_URL=postgresql+asyncpg://nakama:CHANGE_ME@localhost:5432/nakama
# POSTGRES_DB=nakama
# POSTGRES_USER=nakama
# POSTGRES_PASSWORD=CHANGE_ME_USE_32_PLUS_CHARS_RANDOM

# ── Redis ───────────────────────────────────────────────────────────────────
# When set, HTTP cache uses Redis instead of in-memory dict.
# REDIS_URL=redis://localhost:6379/0
# Separate Redis for response cache (optional, falls back to REDIS_URL)
# RESPONSE_CACHE_REDIS_URL=redis://localhost:6379/1

# ── Authentication ──────────────────────────────────────────────────────────
# API key for X-API-Key header auth. When set, /anime /comic /novel require it.
# API_KEY=change-me-to-a-long-random-secret
# JWT secret for user auth tokens. Must be set in production (fails closed otherwise).
# JWT_SECRET=change-me-to-64-chars-random
# Daily API quota per user (default: 1000)
# DEFAULT_DAILY_QUOTA=1000

# ── MCP Server ──────────────────────────────────────────────────────────────
# /mcp exposes every endpoint as an AI-agent tool. Gated behind API_KEY auth.
# Set to 1 ONLY if a trusted MCP client on a private network must reach it.
# MCP_ALLOW_PUBLIC=0

# ── Workers ─────────────────────────────────────────────────────────────────
# Uvicorn worker count. 1 is safe for VPS with ≤4GB RAM (Camoufox overhead).
# UVICORN_WORKERS=1

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Default: * (dev only!)
# ALLOW_ORIGINS=https://app.mynakama.web.id,https://mynakama.web.id

# ── Source Mirrors / Helpers (production) ───────────────────────────────────

# FlareSolverr for Cloudflare-protected HTML sources (sakuranovel, etc.)
# From Docker on this VPS: http://172.17.0.1:8191/v1
# FLARESOLVERR_URL=http://172.17.0.1:8191/v1

# Live base URLs (mirrors rotate)
# KIRYUU_BASE_URL=https://v7.kiryuu.to
# KOMIKCAST_API_BASE=https://be.komikcast.cc
# KOMIKCAST_BASE_URL=https://v3.komikcast.fit
# SAKURANOVEL_BASE_URL=https://sakuranovel.id

# Komikcast chapter IMAGES need a Bearer JWT from the SPA after login:
#   DevTools → Application → Local Storage → key "token" (must start with eyJ)
#   OR Network → be.komikcast.cc request → Request Headers → Authorization: Bearer ***
# KOMIKCAST_TOKEN=eyJhbGciOi...

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
# Public API origin (no secrets — this is exposed to the browser)
# NEXT_PUBLIC_API_BASE=https://app.mynakama.web.id
# Server-only (set by compose): API_INTERNAL_URL=http://api:8000

# ── Email / SMTP (Resend) ───────────────────────────────────────────────────
# Frontend base URL for reset-password / confirm-email links
PUBLIC_BASE_URL=https://app.mynakama.web.id
# Resend SMTP config (100 emails/day free)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
# SMTP_PASS=re_... (your Resend API key)
SMTP_FROM=noreply@app.mynakama.web.id
SMTP_TLS=1

# ── Telegram Alerts (optional) ──────────────────────────────────────────────
# Bot token from @BotFather
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Chat ID (channel or group)
# TELEGRAM_CHAT_ID=-1001234567890
